# ============================================================
# WeiguangPlus - Comprehensive Git Ignore Rules
# Generated: 2026-05-28
# Purpose: Prevent sensitive/temporary files from being committed
# ============================================================

# ---------- IDE & Editor Configuration ----------
# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/
*.code-workspace

# Trae Editor (AI coding assistant)
.trae/

# Debug files
.dbg/
*.dbg

# ---------- Android Build Artifacts ----------
# Gradle
.gradle/
build/
local.properties

# APK/AAB (binary files, too large for Git)
*.apk
*.aab
*.ap_
*.dex

# Android Studio captures
/captures/
.externalNativeBuild/
.cxx/

# Proguard
/app/release/
proguard/

# ---------- Kotlin/Java ----------
*.class
*.jar
*.war
*.ear
*.kotlin_module

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/
htmlcov/
.tox/
.coverage
.pytest_cache/
*.egg-info/
dist/
build/

# ---------- Node.js (if any frontend tools) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3
data/*.sql
!scripts/init-database.sql
data/seed/

# ---------- Secrets & Credentials (CRITICAL!) ----------
.env
.env.local
.env.production
.env.development
secrets.yaml
credentials.json
keystore.jks
*.pem
*.key
*.p12
*.pfx

# ---------- Logs & Temporary ----------
*.log
logs/
*.tmp
*.bak
*.swp
*~
.~lock*/
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

