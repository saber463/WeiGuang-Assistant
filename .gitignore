# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ---------- MinIO / File Uploads ----------
uploads/
minio/data/
temp/

# ---------- Test Results ----------
test-results/
allure-results/
coverage/
.nyc_output/

# ---------- Documentation Build ----------
docs/_build/
site/

